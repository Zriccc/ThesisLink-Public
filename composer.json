{
  "name": "thesislink/school-hosted",
  "description": "School-hosted PHP and MySQL migration of the ThesisLink repository application.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-curl": "*",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-gd": "*",
    "aws/aws-sdk-php": "^3.0",
    "google/apiclient": "^2.0",
    "phpmailer/phpmailer": "^6.0",
    "tecnickcom/tcpdf": "^6.0"
  },
  "autoload": {"psr-4": {"ThesisLink\\": "src/"}},
  "scripts": {"pre-autoload-dump": "Google\\Task\\Composer::cleanup"},
  "extra": {"google/apiclient-services": ["Oauth2"]},
  "config": {"allow-plugins": {}, "sort-packages": true, "platform": {"php": "8.2.0"}}
}
